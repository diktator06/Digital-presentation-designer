# DeckSmith: скопируйте в .env и заполните один из вариантов ниже. Файл .env в git не попадает.
# Если поля модели пустые, сервис работает офлайн: экстрактивный план, аудит только по правилам.

# Профиль запросов: config/vsegpt.yaml — хостинги (VseGPT, OpenRouter); пусто — config/default.yaml (vLLM)
DECKSMITH_CONFIG=

# Тексты (LLM): OpenAI-совместимый endpoint с открытыми весами до 35B
DECKSMITH_LLM_PROVIDER=openai_compatible
DECKSMITH_LLM_BASE_URL=
DECKSMITH_LLM_API_KEY=
DECKSMITH_LLM_MODEL=

# Смысловой аудит по картинке слайда (VLM); пусто — только детерминированные проверки
DECKSMITH_VLM_MODEL=

# Иллюстрации в слайдах (text-to-image): none — выключено, openai_images — через /images/generations
DECKSMITH_IMAGE_PROVIDER=none
DECKSMITH_IMAGE_BASE_URL=
DECKSMITH_IMAGE_API_KEY=
DECKSMITH_IMAGE_MODEL=

# ---------------------------------------------------------------------------------------------
# Вариант А — хостинг VseGPT (так собраны колоды релиза v1.0):
#   DECKSMITH_CONFIG=config/vsegpt.yaml
#   DECKSMITH_LLM_BASE_URL=https://api.vsegpt.ru/v1
#   DECKSMITH_LLM_API_KEY=<ваш ключ VseGPT>
#   DECKSMITH_LLM_MODEL=qwen/qwen3.6-35b-a3b
#   DECKSMITH_VLM_MODEL=qwen/qwen3.8-27b
#   DECKSMITH_IMAGE_PROVIDER=openai_images
#   DECKSMITH_IMAGE_BASE_URL=https://api.vsegpt.ru/v1
#   DECKSMITH_IMAGE_API_KEY=<тот же ключ>
#   DECKSMITH_IMAGE_MODEL=img-flux/flux-2-klein-4b
#
# Вариант Б — свой GPU (vLLM: vllm serve Qwen/Qwen3-32B-AWQ --port 8001) или инференс VK:
#   DECKSMITH_LLM_BASE_URL=http://localhost:8001/v1
#   DECKSMITH_LLM_MODEL=Qwen/Qwen3-32B
#   DECKSMITH_VLM_MODEL=<мультимодальная модель, например Qwen/Qwen3.8-27B>
#
# Вариант В — Ollama на ноутбуке (ollama pull qwen3:4b; адрес и модель заданы в профиле):
#   DECKSMITH_CONFIG=config/local_ollama.yaml
