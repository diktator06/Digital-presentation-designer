# Copy to .env (gitignored; read automatically by `decksmith` and by docker-compose).
# OpenAI-compatible endpoint serving an open-weight model <= 35B (Apache-2.0/MIT).
# a) own GPU server with vLLM:   vllm serve Qwen/Qwen3-32B-AWQ --port 8001
#    DECKSMITH_LLM_BASE_URL=http://localhost:8001/v1   DECKSMITH_LLM_MODEL=Qwen/Qwen3-32B
# b) hosted, e.g. VseGPT (RU):   DECKSMITH_LLM_BASE_URL=https://api.vsegpt.ru/v1   DECKSMITH_LLM_MODEL=qwen/qwen3-32b
#    plus DECKSMITH_CONFIG=config/vsegpt.yaml (reasoning off, retries on 429)   DECKSMITH_VLM_MODEL=qwen/qwen3.8-27b
DECKSMITH_LLM_PROVIDER=openai_compatible
DECKSMITH_LLM_BASE_URL=http://localhost:8001/v1
DECKSMITH_LLM_API_KEY=
DECKSMITH_LLM_MODEL=Qwen/Qwen3-32B
# multimodal model for the contextual (visual) audit; empty = disabled
DECKSMITH_VLM_MODEL=
# text-to-image (FLUX.1-schnell, Apache-2.0) via an OpenAI-compatible /images/generations endpoint
DECKSMITH_IMAGE_PROVIDER=none
DECKSMITH_IMAGE_BASE_URL=
DECKSMITH_IMAGE_API_KEY=
DECKSMITH_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
