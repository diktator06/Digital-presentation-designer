# Скопируйте в .env (файл не попадает в git; его автоматически читают `decksmith` и docker-compose).
# OpenAI-совместимый endpoint с моделью с открытыми весами ≤ 35B (Apache-2.0/MIT).
# а) свой GPU-сервер с vLLM:   vllm serve Qwen/Qwen3-32B-AWQ --port 8001
#    DECKSMITH_LLM_BASE_URL=http://localhost:8001/v1   DECKSMITH_LLM_MODEL=Qwen/Qwen3-32B
# б) хостинг, например VseGPT (РФ):   DECKSMITH_LLM_BASE_URL=https://api.vsegpt.ru/v1   DECKSMITH_LLM_MODEL=qwen/qwen3.6-35b-a3b
#    (35B MoE, 3B активных, Apache-2.0; подходят и qwen/qwen3-32b, qwen/qwen3.8-27b — см. MODELS.md)
#    плюс DECKSMITH_CONFIG=config/vsegpt.yaml (без «размышлений», повторы при 429)   DECKSMITH_VLM_MODEL=qwen/qwen3.8-27b
DECKSMITH_LLM_PROVIDER=openai_compatible
DECKSMITH_LLM_BASE_URL=http://localhost:8001/v1
DECKSMITH_LLM_API_KEY=
DECKSMITH_LLM_MODEL=Qwen/Qwen3-32B
# мультимодальная модель для контекстного (визуального) аудита; пусто = выключен
DECKSMITH_VLM_MODEL=
# генерация изображений (FLUX.1-schnell, Apache-2.0) через OpenAI-совместимый endpoint /images/generations
DECKSMITH_IMAGE_PROVIDER=none
DECKSMITH_IMAGE_BASE_URL=
DECKSMITH_IMAGE_API_KEY=
DECKSMITH_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
